<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Checked state -->
    <item android:state_checked="true">
        <layer-list>
            <!-- Background color -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/white" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
            <!-- Check icon -->
            <item android:drawable="@drawable/check" android:gravity="center" />
        </layer-list>
    </item>

    <!-- Unchecked state -->
    <item android:state_checked="false">
        <layer-list>
            <!-- Border color -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="1dp" android:color="@android:color/black" /> <!-- Black border -->
                    <corners android:radius="5dp" />
                </shape>
            </item>
            <!-- Background color -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/black" /> <!-- Changed color to black -->
                    <corners android:radius="5dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
