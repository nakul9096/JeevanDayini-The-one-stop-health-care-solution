<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background for pressed state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#977C4DFF"/> <!-- Change color as per your preference -->
            <corners android:radius="8dp"/> <!-- Rounded corners, adjust as needed -->
        </shape>
    </item>

    <!-- Background for focused state -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#977C4DFF"/> <!-- Change color as per your preference -->
            <corners android:radius="8dp"/> <!-- Rounded corners, adjust as needed -->
        </shape>
    </item>

    <!-- Default background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/> <!-- Change color as per your preference -->
            <stroke android:color="#000000" android:width="2dp"/> <!-- Border color and width -->
            <corners android:radius="8dp"/> <!-- Rounded corners, adjust as needed -->
        </shape>
    </item>
</selector>
