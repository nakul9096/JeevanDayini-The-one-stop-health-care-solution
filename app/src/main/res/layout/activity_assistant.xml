<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000"
    tools:context=".Assistant">

    <!-- Message Interaction Space (Centered at the top) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cdview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/greetingTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hello!"
                android:textColor="#ffffff"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/helpPromptTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:text="How may I help you today?\nI am your assistant"
                android:textColor="#999"
                android:textSize="16sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Message Container -->
    <RelativeLayout
        android:id="@+id/messageContainer"
        android:layout_width="match_parent"
        android:layout_height="506dp"
        android:layout_above="@id/tagsLayout"
        android:layout_below="@id/cdview"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="37dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/messagesLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- Add a transparent background to avoid issues with the EditText -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

            </LinearLayout>

        </ScrollView>

    </RelativeLayout>

    <!-- Tags Layout -->
    <HorizontalScrollView
        android:id="@+id/tagsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tagAccount"
                android:layout_width="124dp"
                android:layout_height="46dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/rounded_button_setting"
                android:gravity="center"
                android:text="Account related Info"
                android:textSize="12dp" />

            <TextView
                android:id="@+id/tagAccount1"
                android:layout_width="128dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="16dp"
                android:background="@drawable/rounded_button_setting"
                android:gravity="center"
                android:text="Payment related Info"
                android:textSize="12dp" />

            <TextView
                android:id="@+id/tagAccount2"
                android:layout_width="120dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="16dp"
                android:background="@drawable/rounded_button_setting"
                android:gravity="center"
                android:text="Service queries"
                android:textSize="12dp" />

        </LinearLayout>
    </HorizontalScrollView>

    <EditText
        android:id="@+id/messageEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/tagsLayout"
        android:layout_marginLeft="20dp"
        android:layout_marginBottom="-6dp"
        android:background="#000"
        android:hint="Type your message here"
        android:inputType="textMultiLine"
        android:maxLines="5"
        android:minHeight="48dp"
        android:minLines="1"
        android:textColor="#ffffff" />

    <Button
        android:id="@+id/sendButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/tagsLayout"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="19dp"
        android:layout_marginBottom="-6dp"
        android:text="Send" />
</RelativeLayout>
