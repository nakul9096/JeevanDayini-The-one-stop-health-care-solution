<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#85000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="App Settings"
            android:textSize="24sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#cccccc" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="General settings"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnbookings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:backgroundTint="#ffffff"
            android:textColor="#0D47A1"
            android:background="@drawable/rounded_button_setting"
            android:text="Your bookings" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:id="@+id/btnchangelang"
            android:textColor="#0D47A1"
            android:backgroundTint="#ffffff"
            android:background="@drawable/rounded_button_setting"
            android:text="Change language" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:backgroundTint="#ffffff"
            android:id="@+id/btnApperance"
            android:textColor="#0D47A1"
            android:background="@drawable/rounded_button_setting"
            android:text="Appearance setting" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#ffffff"
            android:layout_marginBottom="8dp"
            android:textColor="#0D47A1"
            android:background="@drawable/rounded_button_setting"
            android:text="transactions" />
        <!-- Divider line between sections -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#cccccc" />

        <!-- Help Center Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Help Center"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Options for Help Center -->
        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColor="#0D47A1"
            android:backgroundTint="#ffffff"
            android:background="@drawable/rounded_button_setting"
            android:text="Troubleshoot Issue" />

        <Button
            android:id="@+id/faqbtn"
            android:layout_width="match_parent"
            android:backgroundTint="#ffffff"
            android:textColor="#0D47A1"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/rounded_button_setting"
            android:text="FAQs" />

        <Button
            android:id="@+id/tubutton"
            android:layout_width="match_parent"
            android:backgroundTint="#ffffff"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColor="#0D47A1"
            android:background="@drawable/rounded_button_setting"
            android:text="Tutorial Videos" />

        <Button
            android:id="@+id/contactbtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#ffffff"
            android:textColor="#0D47A1"
            android:background="@drawable/rounded_button_setting"
            android:text="Contact Us" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#cccccc" />

        <!-- Save button -->

        <!-- Privacy & Policy, Terms, Copyright Information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/privacytv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Privacy &amp; Policy"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/termstv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="right"
                android:text="Terms &amp; conditions"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:layout_weight="1"
                android:text=""
                android:textColor="#0000FF" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:contentDescription="Copyright Icon"
                android:src="@drawable/cr" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:layout_weight="1"
                android:padding="20dp"
                android:text="Developed by Nakul Dhande \nPowered by Tanisha Choudhari" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>