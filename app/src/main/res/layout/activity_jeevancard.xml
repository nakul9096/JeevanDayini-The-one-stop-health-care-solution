<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp">

    <!-- Title TextView -->
    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jeevan Card"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="24dp" />

    <!-- Lottie Animation View -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieAnimationView"
        android:layout_width="500dp"
        android:layout_height="300dp"
        android:layout_below="@id/titleTextView"
        android:layout_marginTop="33dp"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/jeevancard" />

    <!-- Card Description TextView -->
    <TextView
        android:id="@+id/descriptionTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jeevancard is a type of physical card which carries all of your information including personal info, medical info, test reports, etc. A one time payment card at just rs 99. which facilities hassle free experience, no worry to carry bulky reports and all and all!"
        android:layout_below="@id/lottieAnimationView"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="24dp" />

    <!-- Apply Now Button -->
    <Button
        android:id="@+id/applyNowButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#ffffff"
        android:text="Apply Now"
        android:textColor="#000000"
        android:layout_below="@id/descriptionTextView"
       />
</RelativeLayout>
