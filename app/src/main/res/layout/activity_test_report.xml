<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".TestReport">

    <!-- Container for dynamically added prescription cards -->
    <LinearLayout
        android:id="@+id/linearlayoutcontainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
    </LinearLayout>

    <!-- Container for "no data found" message and progress bar -->
    <LinearLayout
        android:id="@+id/emptyStateContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:layout_below="@id/linearlayoutcontainer"
        android:orientation="vertical">

        <!-- Initial loading indicator -->
        <ProgressBar
            android:id="@+id/progressBarTR"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="visible" /> <!-- Initially visible -->

        <!-- Lottie Animation View - only visible when no data is found -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieAnimationViewTR"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_gravity="center_horizontal"
            app:lottie_rawRes="@raw/notfound"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            android:visibility="gone" /> <!-- Initially gone -->

        <!-- Title for no prescription found message -->
        <TextView
            android:id="@+id/textViewTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:text="No Prescription Found"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#FF6F00"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone" /> <!-- Initially gone -->

        <!-- Subtitle for no prescription found message -->
        <TextView
            android:id="@+id/textViewSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="It may not have been uploaded yet. \nPlease check again later."
            android:textSize="22sp"
            android:textColor="@android:color/darker_gray"
            android:visibility="gone" /> <!-- Initially gone -->
    </LinearLayout>

</RelativeLayout>