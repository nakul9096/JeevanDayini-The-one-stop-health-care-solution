<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B5FFAB40">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="7dp">

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:visibility="visible" />

            <!-- Clinic card content -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardClinic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/android_fade"
            android:padding="16dp">

            <TextView
                android:id="@+id/textClinicName1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Clinic Name"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Add borders between sections -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC" />

            <!-- Clinic Type -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/clinic" />

                <TextView
                    android:id="@+id/textClinictype"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:text="Clinic Type"
                    android:textColor="#757575"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Add borders between sections -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC" />

            <!-- Preview Images -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="16dp">

                <!-- Four preview images with rounded corners -->
                <ImageView
                    android:id="@+id/imagePreview1"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/imageviewnew"
                    android:scaleType="centerCrop" />

                            <ImageView
                                android:id="@+id/imagePreview2"
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:layout_marginRight="8dp"
                                android:scaleType="centerCrop" />

                            <ImageView
                                android:id="@+id/imagePreview3"
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:layout_marginRight="8dp"
                                android:scaleType="centerCrop" />

                            <ImageView
                                android:id="@+id/imagePreview4"
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:scaleType="centerCrop" />
                        </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <ImageView
                    android:id="@+id/starIcon"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/staricon" /> <!-- Make sure you have a star icon in your drawables -->

                <TextView
                    android:id="@+id/textRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@id/starIcon"
                    android:text="4.5/5"
                    android:textColor="#CDCDCD"
                    android:textSize="20sp" />
            </RelativeLayout>

            <!-- Clinic Address -->
            <TextView
                android:id="@+id/textClinicAddress1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Clinic Address"
                android:textColor="#CDCDCD"
                android:textSize="18sp" />

        <!-- Clinic Location -->
        <TextView
            android:id="@+id/textCliniclocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Clinic Location"
            android:textColor="#CDCDCD"
            android:textSize="18sp" />

        <!-- Book Appointment Button -->
        <Button
            android:id="@+id/buttonBookAppointment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_blue_button"
            android:text="Book Appointment Slot"
            android:textColor="#FFFFFF" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </RelativeLayout>
        <TableLayout
            android:id="@+id/tableLayoutSchedule"
            android:layout_width="match_parent"
            android:padding="10dp"
            android:layout_height="wrap_content">
            <TableRow  android:background="#000000">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:gravity="center"
                    android:text="Day"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:gravity="center"
                    android:text="Timings"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </TableRow>
            <!-- Days and timings rows -->
            <TableRow>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/table_cell_border"
                    android:gravity="left"
                    android:paddingLeft="10dp"
                    android:text="Monday"
                    android:textColor="#000000"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/textMondayTimings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/table_cell_border"
                    android:gravity="center"
                    android:text="9:00 AM - 10:00 PM"
                    android:textColor="#000000"
                    android:textSize="16sp" />
            </TableRow>

            <TableRow>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/table_cell_border"
                    android:gravity="left"
                    android:paddingLeft="10dp"
                    android:text="Tuesday"
                    android:textColor="#000000"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/textTuesdayTimings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/table_cell_border"
                    android:gravity="center"
                    android:text="9:00 AM - 10:00 PM"
                    android:textColor="#000000"
                    android:textSize="16sp" />
            </TableRow>

            <TableRow>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/table_cell_border"
                    android:gravity="left"
                    android:paddingLeft="10dp"
                    android:text="Wednesday"
                    android:textColor="#000000"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/textWednesdayTimings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/table_cell_border"
                    android:gravity="center"
                    android:text="9:00 AM - 10:00 PM"
                    android:textColor="#000000"
                    android:textSize="16sp" />
            </TableRow>

            <TableRow>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/table_cell_border"
                    android:gravity="left"
                    android:paddingLeft="10dp"
                    android:text="Thursday"
                    android:textColor="#000000"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/textThursdayTimings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/table_cell_border"
                    android:gravity="center"
                    android:text="9:00 AM - 10:00 PM"
                    android:textColor="#000000"
                    android:textSize="16sp" />
            </TableRow>

            <TableRow>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/table_cell_border"
                    android:gravity="left"
                    android:paddingLeft="10dp"
                    android:text="Friday"
                    android:textColor="#000000"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/textFridayTimings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/table_cell_border"
                    android:gravity="center"
                    android:text="9:00 AM - 10:00 PM"
                    android:textColor="#000000"
                    android:textSize="16sp" />
            </TableRow>

            <TableRow>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/table_cell_border"
                    android:gravity="left"
                    android:paddingLeft="10dp"
                    android:text="Saturday"
                    android:textColor="#000000"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/textSaturdayTimings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/table_cell_border"
                    android:gravity="center"
                    android:text="9:00 AM - 10:00 PM"
                    android:textColor="#000000"
                    android:textSize="16sp" />
            </TableRow>

            <TableRow>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/table_cell_border"
                    android:gravity="left"
                    android:paddingLeft="10dp"
                    android:text="Sunday"
                    android:textColor="#000000"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/textSundayTimings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/table_cell_border"
                    android:gravity="center"
                    android:text="9:00 AM - 10:00 PM"
                    android:textColor="#000000"
                    android:textSize="16sp" />
            </TableRow>
        </TableLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:layout_marginTop="5dp">

            <!-- Blurred map image -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:scaleType="centerCrop"
                android:src="@drawable/map" />

            <!-- Button to view on map -->
            <Button
                android:id="@+id/buttonViewOnMap"
                android:layout_width="118dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="8dp"
                android:background="@drawable/bg_blue_button"
                android:text="View on Map"
                android:textColor="#FFFFFF" />
        </FrameLayout>
    </LinearLayout>
</ScrollView>