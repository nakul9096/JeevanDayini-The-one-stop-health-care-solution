<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F5F5F5"
        android:padding="16dp">

        <TextView
            android:id="@+id/bloodbankNameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hospital Name"
            android:textColor="#333333"
            android:textSize="22sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:id="@+id/imageViewBar"
            android:layout_below="@id/bloodbankNameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imageView1"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:adjustViewBounds="true"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/placeholder"/>

                <ImageView
                    android:id="@+id/imageView2"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:adjustViewBounds="true"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/placeholder"/>

                <ImageView
                    android:id="@+id/imageView3"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:adjustViewBounds="true"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/placeholder"/>

                <ImageView
                    android:id="@+id/imageView4"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:adjustViewBounds="true"
                    android:src="@drawable/placeholder"/>
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/addressTextView"
            android:layout_below="@id/imageViewBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hospital Address"
            android:textColor="#666666"
            android:textSize="18sp"
            android:layout_marginTop="8dp"
            />

        <Button
            android:id="@+id/donateBtn"
            android:layout_below="@id/addressTextView"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Donate Blood"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/red_button_background"
            android:padding="16dp"
            android:layout_marginTop="16dp"/>
    </RelativeLayout>
</androidx.cardview.widget.CardView>