<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#163D5AFE">

    <!-- Main content layout -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <!-- More Options Icon -->
                <ImageView
                    android:id="@+id/menuPlaceholder"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:contentDescription="More Options"
                    android:onClick="openLeftMenuDrawer"
                    android:src="@drawable/menu"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/helloTextView"
                    android:layout_width="247dp"
                    android:layout_height="84dp"
                    android:layout_gravity="end"
                    android:gravity="end"
                    android:paddingTop="10dp"
                    android:paddingRight="10dp"
                    android:text="Hello, User"
                    android:textSize="17dp"
                    app:layout_constraintEnd_toStartOf="@+id/imageView14"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toEndOf="@+id/menuPlaceholder"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/imageView14"
                    android:layout_width="33dp"
                    android:layout_height="33dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="30dp"
                    android:src="@drawable/profile"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/light_blue_A400" />

                <!-- Down Arrow Icon -->
                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="39dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:onClick="showPopupMenu"
                    android:src="@drawable/down_arrow"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/white" />

                <!-- Admin ID TextView -->
                <TextView
                    android:id="@+id/adminIdTextView4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="8dp"
                    android:text="Admin ID:"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/menuPlaceholder" />

                <!-- Hello Card -->
                <RelativeLayout
                    android:id="@+id/cardHello"
                    android:layout_width="1000dp"
                    android:layout_height="150dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="40dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/rounded_white_background"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/adminIdTextView4">

                    <TextView
                        android:id="@+id/organizationNameTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="Hello!"
                        android:textColor="#000000"
                        android:textSize="18sp" />

                    <!-- Button to set the clinic name -->
                    <Button
                        android:id="@+id/setClinicNameButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/organizationNameTV"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="8dp"
                        android:text="Set Clinic Name" />

                </RelativeLayout>

                <!-- Ongoing appointment TextView -->

                <!-- Box to enter number -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Ongoing Appointment:"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toStartOf="@+id/ongoingAppointmentEditText"
                    app:layout_constraintHorizontal_bias="0.122"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cardHello" />

                <EditText
                    android:id="@+id/ongoingAppointmentEditText"
                    android:layout_width="130dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:layout_marginRight="5dp"
                    android:background="@drawable/edittext_background"
                    android:hint="Enter Number"
                    android:inputType="number"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cardHello" />

                <!-- HorizontalScrollView for ImageViews -->
                <HorizontalScrollView
                    android:id="@+id/hsvimages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toTopOf="@+id/tableLayoutSchedule"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ongoingAppointmentEditText">


                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- ImageView18 and other ImageViews -->
                        <ImageView
                            android:id="@+id/imageView18"
                            android:layout_width="120dp"
                            android:layout_height="182dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/vertical"
                            app:layout_constraintWidth_default="percent"
                            app:layout_constraintWidth_percent="0.25" />

                        <ImageView
                            android:id="@+id/imageView2"
                            android:layout_width="120dp"
                            android:layout_height="185dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/horizontal"
                            app:layout_constraintEnd_toStartOf="@+id/imageView3"
                            app:layout_constraintStart_toEndOf="@+id/imageView18"
                            app:layout_constraintTop_toBottomOf="@+id/imageView18"
                            app:layout_constraintWidth_default="percent"
                            app:layout_constraintWidth_percent="0.25" />

                        <ImageView
                            android:id="@+id/imageView3"
                            android:layout_width="120dp"
                            android:layout_height="185dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/horizontal"
                            app:layout_constraintEnd_toStartOf="@+id/imageView4"
                            app:layout_constraintStart_toEndOf="@+id/imageView2"
                            app:layout_constraintTop_toBottomOf="@+id/imageView18"
                            app:layout_constraintWidth_default="percent"
                            app:layout_constraintWidth_percent="0.25" />

                        <ImageView
                            android:id="@+id/imageView4"
                            android:layout_width="120dp"
                            android:layout_height="185dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/horizontal"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/imageView3"
                            app:layout_constraintTop_toBottomOf="@+id/imageView18"
                            app:layout_constraintWidth_default="percent"
                            app:layout_constraintWidth_percent="0.25" />

                    </LinearLayout>
                </HorizontalScrollView>

                <TableLayout
                    android:id="@+id/tableLayoutSchedule"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/hsvimages">

                    <!-- Table header -->
                    <TableRow android:background="@drawable/table_border">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Day"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Timings"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Action"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </TableRow>

                    <!-- Days and timings rows -->
                    <TableRow>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="left"
                            android:paddingLeft="10dp"
                            android:text="Monday"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/textMondayTimings"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text=""
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/buttonMonday"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:onClick="setTimingButtonClick"
                            android:text="Set" />
                    </TableRow>
                    <!-- Tuesday -->
                    <TableRow>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="left"
                            android:paddingLeft="10dp"
                            android:text="Tuesday"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/textTuesdayTimings"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text=""
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/buttonTuesday"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:onClick="setTimingButtonClick"
                            android:text="Set" />
                    </TableRow>

                    <!-- Wednesday -->
                    <TableRow>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="left"
                            android:paddingLeft="10dp"
                            android:text="Wednesday"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/textWednesdayTimings"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text=""
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/buttonWednesday"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:onClick="setTimingButtonClick"
                            android:text="Set" />
                    </TableRow>

                    <!-- Thursday -->
                    <TableRow>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="left"
                            android:paddingLeft="10dp"
                            android:text="Thursday"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/textThursdayTimings"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text=""
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/buttonThursday"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:onClick="setTimingButtonClick"
                            android:text="Set" />
                    </TableRow>

                    <!-- Friday -->
                    <TableRow>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="left"
                            android:paddingLeft="10dp"
                            android:text="Friday"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/textFridayTimings"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text=""
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/buttonFriday"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:onClick="setTimingButtonClick"
                            android:text="Set" />
                    </TableRow>

                    <!-- Saturday -->
                    <TableRow>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="left"
                            android:paddingLeft="10dp"
                            android:text="Saturday"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/textSaturdayTimings"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text=""
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/buttonSaturday"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:onClick="setTimingButtonClick"
                            android:text="Set" />
                    </TableRow>

                    <!-- Sunday -->
                    <TableRow>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="left"
                            android:paddingLeft="10dp"
                            android:text="Sunday"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/textSundayTimings"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text=""
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/buttonSunday"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:onClick="setTimingButtonClick"
                            android:text="Set" />
                    </TableRow>
                </TableLayout>

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toTopOf="@+id/tableLayoutSchedule"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/adminIdTextView4"
                    app:layout_constraintVertical_bias="0.021">

                    <TextView
                        android:id="@+id/marqueeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="marquee"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="right"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:scrollHorizontally="true"
                        android:singleLine="true"
                        android:text="Your clinic is not live! To go live, visit List clinic online section available in the More Options menu. Thank you for using JEEVANDAYINI App!"
                        android:textColor="#F4511E"
                        android:textSize="17sp" />
                </HorizontalScrollView>

                <View
                    android:id="@+id/dividerView"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@android:color/darker_gray"
                    app:layout_constraintTop_toBottomOf="@+id/tableLayoutSchedule" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="16dp"
                    android:text="Map URL"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toStartOf="@+id/buttonSetMapUrl"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/dividerView" />

                <!-- SET Map URL Button below the table -->
                <Button
                    android:id="@+id/buttonSetMapUrl"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="10dp"
                    android:background="@drawable/button_background"
                    android:text="SET"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/dividerView" />

                <View
                    android:id="@+id/dividerView2"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="90dp"
                    android:background="@android:color/darker_gray"
                    app:layout_constraintTop_toBottomOf="@+id/tableLayoutSchedule" />
                <!-- Below the dividerView2 -->
                <!-- Below the dividerView2 -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="16dp"
                    android:text="Blood Donation Facility"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toStartOf="@+id/buttonSetBloodDonation"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/dividerView2" />

                <Button
                    android:id="@+id/buttonSetBloodDonation"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="10dp"
                    android:background="@drawable/button_background"
                    android:text="SET"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/dividerView2" />

                <View
                    android:id="@+id/dividerView3"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="15dp"
                    android:background="@android:color/darker_gray"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/buttonSetBloodDonation" />

                <!-- Below the Blood Donation Facility -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="8dp"
                    android:text="Other Information"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toStartOf="@+id/buttonSetOtherInformation"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/dividerView3" />

                <Button
                    android:id="@+id/buttonSetOtherInformation"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="10dp"
                    android:background="@drawable/button_background"
                    android:text="SET"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/dividerView3" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/drawer_menu" />
</androidx.drawerlayout.widget.DrawerLayout>