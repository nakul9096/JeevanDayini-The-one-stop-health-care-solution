<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f0f2f5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Donor Registration Form"
            android:textColor="#212121"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="* Indicates mandatory fields"
            android:textColor="#E53935"
            android:gravity="end"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="70dp"
            app:cardElevation="8dp"
            android:layout_marginBottom="16dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/imageViewPhotoProof"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/profil" />

                <ProgressBar
                    android:id="@+id/progressBarnew"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/buttonUploadPhotoProof"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:text="Upload Photo Proof"
            android:textColor="#ffffff"
            android:backgroundTint="#008080"
            app:cornerRadius="12dp" />

        <TextView
            android:id="@+id/textViewUploadStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:text="Photo upload successful!"
            android:textColor="#4CAF50"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textViewRelationType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Relation Type:"
            android:textColor="#212121"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etFullname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Full Name"
            android:textColorHint="#000000"
            android:inputType="textPersonName"
            android:padding="12dp"
            android:background="@drawable/rounded_edittext_background" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Blood Group *"
            android:textColor="#212121"
            android:textSize="16sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <RadioGroup
                android:id="@+id/radioGroupBloodGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A+"
                    android:textColor="#212121"
                    android:buttonTint="#008080" />
                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A-"
                    android:textColor="#212121"
                    android:buttonTint="#008080" />
                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="B+"
                    android:textColor="#212121"
                    android:buttonTint="#008080" />
                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="B-"
                    android:textColor="#212121"
                    android:buttonTint="#008080" />
                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AB+"
                    android:textColor="#212121"
                    android:buttonTint="#008080" />
                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AB-"
                    android:textColor="#212121"
                    android:buttonTint="#008080" />
                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="O+"
                    android:textColor="#212121"
                    android:buttonTint="#008080" />
                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="O-"
                    android:textColor="#212121"
                    android:buttonTint="#008080" />
            </RadioGroup>
        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Birth date *"
            android:textColor="#212121"
            android:textSize="16sp" />

        <Button
            android:id="@+id/textViewChooseDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Choose date"
            android:backgroundTint="#BDBDBD"
            android:textColor="#424242"
            app:cornerRadius="12dp" />

        <TextView
            android:id="@+id/textViewAgeWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Below 18 age group are not allowed to donate blood"
            android:textColor="#E53935"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Gender *"
            android:textColor="#212121"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/radioGroupGender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Male"
                android:textColor="#212121"
                android:buttonTint="#008080" />
            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Female"
                android:textColor="#212121"
                android:buttonTint="#008080" />
            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Other"
                android:textColor="#212121"
                android:buttonTint="#008080" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Occupation"
            android:textColor="#212121"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/eOccupation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#000000"
            android:inputType="text"
            android:padding="12dp"
            android:background="@drawable/rounded_edittext_background" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Phone Number *"
            android:textColor="#212121"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/ePhoneNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:inputType="phone"
            android:maxLength="10"
            android:textColor="#000000"
            android:padding="12dp"
            android:background="@drawable/rounded_edittext_background" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Email *"
            android:textColor="#212121"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/eEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:layout_marginTop="8dp"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:background="@drawable/rounded_edittext_background" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Address (street) *"
            android:textColor="#212121"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/eAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#000000"
            android:inputType="text"
            android:padding="12dp"
            android:background="@drawable/rounded_edittext_background" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="State"
            android:textColor="#212121"
            android:textSize="16sp" />
        <Spinner
            android:id="@+id/SpinnerState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:background="@drawable/spinner_background"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="City"
            android:textColor="#212121"
            android:textSize="16sp" />
        <Spinner
            android:id="@+id/SpinnerCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:background="@drawable/spinner_background"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Pincode"
            android:textColor="#212121"
            android:textSize="16sp" />
        <EditText
            android:id="@+id/etpostalcode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:inputType="numberDecimal"
            android:textColor="#000000"
            android:maxLength="6"
            android:padding="12dp"
            android:background="@drawable/rounded_edittext_background" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Aadhaar Number *"
            android:textColor="#212121"
            android:textSize="16sp" />
        <EditText
            android:id="@+id/eAadhaarNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:inputType="number"
            android:textColor="#000000"
            android:maxLength="12"
            android:padding="12dp"
            android:background="@drawable/rounded_edittext_background" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Upload Aadhaar Card *"
                android:textColor="#000000"
                android:textSize="16sp" />
            <Button
                android:id="@+id/buttonUploadAadhaarCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upload"
                android:backgroundTint="#008080"
                style="@style/ProfileActionButton"
                app:cornerRadius="12dp"
                android:textColor="#ffffff"/>
            <ProgressBar
                android:id="@+id/progressBarAadhar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Did you ever donate blood before? *"
            android:textColor="#212121"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/radioGroupBloodDonation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/radioButtonBloodDonationYes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yes"
                android:layout_marginEnd="16dp"
                android:textColor="#212121"
                android:buttonTint="#008080" />
            <RadioButton
                android:id="@+id/radioButtonBloodDonationNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No"
                android:textColor="#212121"
                android:buttonTint="#008080" />
        </RadioGroup>

        <TextView
            android:id="@+id/textViewDescribeDonation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Describe when you donated blood recently *"
            android:textColor="#212121"
            android:textSize="16sp"
            android:visibility="gone" />
        <Button
            android:id="@+id/buttonChooseDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Choose Date"
            android:backgroundTint="#BDBDBD"
            android:textColor="#424242"
            app:cornerRadius="12dp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Did you suffer from any diseases? *"
            android:textColor="#212121"
            android:textSize="16sp" />
        <RadioGroup
            android:id="@+id/radioGroupDiseaseHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/radioButtonDiseaseHistoryYes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yes"
                android:layout_marginEnd="16dp"
                android:textColor="#212121"
                android:buttonTint="#008080" />
            <RadioButton
                android:id="@+id/radioButtonDiseaseHistoryNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No"
                android:textColor="#212121"
                android:buttonTint="#008080" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvadditionalinfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Describe illness *"
            android:textColor="#212121"
            android:textSize="16sp"
            android:visibility="gone" />
        <EditText
            android:id="@+id/editTextAdditionalInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:background="@drawable/rounded_edittext_background"
            android:visibility="gone" />

        <Button
            android:id="@+id/buttonSubmit"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:text="Submit"
            style="@style/ProfileActionButton"
            android:textColor="#ffffff"
            android:backgroundTint="#008080"
            app:cornerRadius="12dp"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>