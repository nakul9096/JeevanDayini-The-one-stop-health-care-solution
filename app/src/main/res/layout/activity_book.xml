<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#51E8E8E8">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <!-- TextView to display selected date -->
        <TextView
            android:id="@+id/selectedDateTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            android:textColor="#000000"
            android:textSize="18sp"
            android:visibility="gone" />
        <!-- Button to update date -->
        <Button
            android:id="@+id/updateDateBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/selectedDateTextView"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp"
            android:text="SELECT DATE" />

        <LinearLayout
            android:id="@+id/bookedSlotInfoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/updateDateBtn"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="8dp"
                android:background="#FF5722" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Available slot: Slots that are available for booking"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/availableSlotInfoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/bookedSlotInfoContainer"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="8dp"
                android:background="#B200C853" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Available Slots: Slots that are selected by you"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Information about Selected Slots -->
        <LinearLayout
            android:id="@+id/selectedSlotInfoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/availableSlotInfoContainer"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="8dp"
                android:background="#808080" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selected Slots: Slots that are already booked"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/estimatedDurationTextView1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/selectedSlotInfoContainer"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="16dp"
            android:text="Estimated duration taken for each token:"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/estimatedDurationTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/estimatedDurationTextView1"
            android:layout_marginLeft="10dp"
            android:background="#00000000"
            android:padding="5dp"
            android:text="15 Min"
            android:textAlignment="center"
            android:textColor="#FF0000"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="visible" />

        <TextView
            android:id="@+id/currentTokenTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/estimatedDurationTextView"
            android:layout_centerHorizontal="true"
            android:text="Current token: NOT SET"
            android:textSize="18sp"
            android:textColor="#FFD600" />

        <LinearLayout
            android:id="@+id/slotsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/currentTokenTextView"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Slots:"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/continuebtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/slotsContainer"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            android:text="Proceed" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/continuebtn"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            android:text="No slots booked!"
            android:textSize="18sp"
            android:visibility="gone" />

    </RelativeLayout>
</ScrollView>