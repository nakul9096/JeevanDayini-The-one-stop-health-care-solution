<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="16dp">

    <RelativeLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".UploadTestReport">

        <!-- Top Heading -->
        <TextView
            android:id="@+id/textViewHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:singleLine="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp"
            android:text="Upload Prescription"
            android:textSize="24sp"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <!-- Search EditText -->
        <EditText
            android:id="@+id/editTextSearch"
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/textViewHeading"
            android:layout_marginTop="16dp"
            android:layout_marginRight="90dp"
            android:capitalize="characters"
            android:hint="Search with userid"
            android:maxLength="6"
            android:padding="16dp" />

        <!-- Search Button -->
        <Button
            android:id="@+id/buttonSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/textViewHeading"
            android:layout_alignTop="@id/editTextSearch"
            android:layout_alignBottom="@id/editTextSearch"
            android:layout_alignParentEnd="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Search" />

        <!-- Not Found Text -->
        <TextView
            android:id="@+id/textViewNotFound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/buttonSearch"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="32dp"
            android:text="User or appointment not found!"
            android:textSize="20sp"
            android:textColor="@android:color/white"
            android:visibility="gone" />

        <!-- Additional Layout for Content -->
        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/textViewNotFound"
            android:orientation="vertical">
            <!-- Add more UI components here as needed -->
        </LinearLayout>
    </RelativeLayout>
</ScrollView>
