<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/gradient_header"
            android:paddingHorizontal="16dp"
            android:paddingTop="32dp"
            android:paddingBottom="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/profilePhoto"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:scaleType="centerCrop"
                android:src="@drawable/phi1"
                android:contentDescription="profile_picture"
                android:background="@drawable/circle_mask"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/nameTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="Your Name"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/profilePhoto"
                app:layout_constraintTop_toTopOf="@id/profilePhoto" />

            <Button
                android:id="@+id/btnEarnedBadges"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="8dp"
                android:text="View Earned Badges"
                android:textColor="@color/text_primary"
                android:background="@drawable/button_outline"
                android:drawableStart="@drawable/ic_star"
                android:drawablePadding="8dp"
                android:paddingHorizontal="16dp"
                app:layout_constraintStart_toEndOf="@id/profilePhoto"
                app:layout_constraintTop_toBottomOf="@id/nameTextView"
                app:layout_constraintEnd_toEndOf="parent" />

            <Switch
                android:id="@+id/profilePrivacySwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:text="Make profile private"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/profilePhoto"
                app:layout_constraintTop_toBottomOf="@id/btnEarnedBadges" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/info_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/card_background"
            app:layout_constraintTop_toBottomOf="@id/header_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    style="@style/ProfileItemContainer">
                    <TextView
                        style="@style/ProfileLabel"
                        android:text="User ID:" />
                    <TextView
                        android:id="@+id/userIdTextView"
                        style="@style/ProfileValue"
                        tools:text="12345" />
                </LinearLayout>

                <LinearLayout
                    style="@style/ProfileItemContainer">
                    <TextView
                        style="@style/ProfileLabel"
                        android:text="Email:" />
                    <TextView
                        android:id="@+id/emailTextView"
                        style="@style/ProfileValue"
                        tools:text="user@example.com" />
                </LinearLayout>

                <LinearLayout
                    style="@style/ProfileItemContainer">
                    <TextView
                        style="@style/ProfileLabel"
                        android:text="Gender:" />
                    <TextView
                        android:id="@+id/genderTextView"
                        style="@style/ProfileValue"
                        tools:text="Male" />
                </LinearLayout>

                <LinearLayout
                    style="@style/ProfileItemContainer">
                    <TextView
                        style="@style/ProfileLabel"
                        android:text="State:" />
                    <TextView
                        android:id="@+id/stateTextView"
                        style="@style/ProfileValue"
                        tools:text="California" />
                </LinearLayout>

                <LinearLayout
                    style="@style/ProfileItemContainer">
                    <TextView
                        style="@style/ProfileLabel"
                        android:text="City:" />
                    <TextView
                        android:id="@+id/cityTextView"
                        style="@style/ProfileValue"
                        tools:text="San Francisco" />
                </LinearLayout>

                <LinearLayout
                    style="@style/ProfileItemContainer">
                    <TextView
                        style="@style/ProfileLabel"
                        android:text="Phone Number:" />
                    <TextView
                        android:id="@+id/phoneTextView"
                        style="@style/ProfileValue"
                        tools:text="+1234567890" />
                </LinearLayout>

                <LinearLayout
                    style="@style/ProfileItemContainer">
                    <TextView
                        style="@style/ProfileLabel"
                        android:text="Blood Group:" />
                    <TextView
                        android:id="@+id/bloodGroupTextView"
                        style="@style/ProfileValue"
                        tools:text="O+" />
                </LinearLayout>

                <LinearLayout
                    style="@style/ProfileItemContainer">
                    <TextView
                        style="@style/ProfileLabel"
                        android:text="Aadhar Number:" />
                    <TextView
                        android:id="@+id/aadharNumberTextView"
                        style="@style/ProfileValue"
                        tools:text="1234-5678-9012" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/info_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:gravity="center">

                <Button
                    android:id="@+id/changePasswordButton"
                    style="@style/ProfileActionButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Change Password" />

                <Button
                    android:id="@+id/EditProfileButton"
                    style="@style/ProfileActionButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Logged-in devices" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginTop="16dp"
                android:gravity="center">

                <Button
                    android:id="@+id/nfcButton"
                    style="@style/ProfileActionButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Update NFC Card" />

                <Button
                    android:id="@+id/readNfcButton"
                    style="@style/ProfileActionButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Read NFC Card" />
            </LinearLayout>

            <Button
                android:id="@+id/getQrButton"
                style="@style/ProfileActionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/button_outline"
                android:text="Get QR"
                android:drawableStart="@drawable/ic_qr"
                android:drawablePadding="8dp"
                android:paddingHorizontal="16dp"/>

            <Button
                android:id="@+id/logoutButton"
                style="@style/ProfileActionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="#D0FF0000"
                android:background="@drawable/button"
                android:text="Logout" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/fragment_container7"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/info_card" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>