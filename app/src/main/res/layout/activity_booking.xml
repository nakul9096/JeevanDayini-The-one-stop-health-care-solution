<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- "Appointment Booking" text -->
        <TextView
            android:id="@+id/appointmentText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:text="Appointment Booking"
            android:textColor="#ffffff"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="600dp"
            android:layout_below="@id/appointmentText"
            android:layout_marginTop="37dp"
            android:orientation="vertical">

            <EditText
                android:id="@+id/fullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:hint="Full Name *"
                android:minHeight="48dp"
                android:padding="8dp" />

            <EditText
                android:id="@+id/phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:hint="Phone *"
                android:inputType="phone"
                android:maxLength="10"
                android:minHeight="48dp"
                android:padding="8dp" />

            <EditText
                android:id="@+id/email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:hint="email"
                android:inputType="textEmailAddress"
                android:minHeight="48dp"
                android:padding="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:padding="2dp"
                android:text="Token number"
                android:textColor="#651FFF"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/tokennumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:enabled="false"
                android:hint="token number"
                android:minHeight="48dp"
                android:padding="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:padding="2dp"
                android:text="Appointment date"
                android:textColor="#651FFF"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/dateet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:enabled="false"
                android:hint="appointment date"
                android:minHeight="48dp"
                android:padding="8dp" />

            <Button
                android:id="@+id/proceedbtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:background="@drawable/cool_button_background"
                android:onClick="bookAppointment"
                android:padding="12dp"
                android:text="Proceed to payment"
                android:textColor="#ffffff"
                android:textSize="13dp" />
        </LinearLayout>
    </RelativeLayout>
</ScrollView>