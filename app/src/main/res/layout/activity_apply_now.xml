<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#C32B2B2A"
    android:padding="16dp"
    tools:context=".ApplyNow">


    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        app:cardCornerRadius="10dp"
        app:cardElevation="8dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#f9f9f9"
            android:padding="20dp">

        <TextView
            android:id="@+id/titleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Are you sure? You want to apply"
            android:textColor="#333333"
            android:textSize="20sp"
            android:layout_centerHorizontal="true"/>

        <TextView
            android:id="@+id/hospitalNameTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hospital/Clinic Name"
            android:textColor="#333333"
            android:textSize="18sp"
            android:layout_below="@id/titleTextView"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:textStyle="bold"/>

        <!-- Below added TextViews -->
        <TextView
            android:id="@+id/userIdTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User ID"
            android:textColor="#333333"
            android:textSize="15sp"
            android:layout_below="@id/hospitalNameTextView"
            android:layout_marginTop="20dp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/aadharNumberTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aadhar Number"
            android:textColor="#333333"
            android:textSize="15sp"
            android:layout_below="@id/userIdTextView"
            android:layout_marginTop="20dp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/relationTypeTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Relation Type"
            android:textColor="#333333"
            android:textSize="15sp"
            android:layout_below="@id/aadharNumberTextView"
            android:layout_marginTop="20dp"
            android:textStyle="bold"/>
            <TextView
                android:id="@+id/infoTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Donation schedule and timings will be provided by hospital/clinic via communication modes like phone and email provided by you!"
                android:textColor="#333333"
                android:textSize="15sp"
                android:layout_below="@id/relationTypeTextView"
                android:layout_marginTop="20dp" />
        <LinearLayout
            android:id="@+id/buttonLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/infoTextView"
            android:layout_marginTop="24dp"
            android:gravity="center">

            <Button
                android:id="@+id/applyButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yes, Apply"
                android:textColor="#ffffff"
                android:background="@drawable/round_theme"
                android:textStyle="bold"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginEnd="16dp"/>

            <Button
                android:id="@+id/goBackButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No, Go back"
                android:textColor="#ffffff"
                android:background="@drawable/round_theme2"
                android:textStyle="bold"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginStart="16dp"/>
        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
</RelativeLayout>